{"$schema": "http://json-schema.org/draft-07/schema#", "title": "NL Injury Data Schema", "description": "Schema for validating INJURY-DATA.json entries for NL Injury Tracker", "type": "object", "required": ["meta", "players"], "properties": {"meta": {"type": "object", "required": ["last_updated", "total_players_tracked"], "properties": {"database_name": {"type": "string"}, "description": {"type": "string"}, "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "version": {"type": "string"}, "total_players_tracked": {"type": "integer", "minimum": 1}}}, "players": {"type": "object", "patternProperties": {"^[a-z0-9-]+$": {"type": "object", "required": ["name", "team", "position", "status", "status_color", "current_injury"], "properties": {"name": {"type": "string"}, "team": {"type": "string"}, "position": {"type": "string"}, "league": {"type": "string"}, "jersey_number": {"type": "integer"}, "status": {"type": "string"}, "status_color": {"type": "string", "enum": ["green", "yellow", "red"]}, "current_injury": {"type": "object", "required": ["type", "date_reported", "mechanism", "severity", "details"], "properties": {"type": {"type": "string"}, "date_reported": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "mechanism": {"type": "string"}, "severity": {"type": "string", "enum": ["Mild", "Moderate", "Moderate to severe", "Severe"]}, "details": {"type": "string"}, "is_acute": {"type": "boolean"}}}, "pre_injury_stats": {"type": "object"}, "rehab_timeline": {"type": "object", "properties": {"started": {"type": "string"}, "expected_return": {"type": "string"}, "uncertainty": {"type": "string"}}}, "return_status": {"type": "string"}, "injury_history": {"type": "array", "items": {"type": "object", "properties": {"date": {"type": "string"}, "type": {"type": "string"}, "details": {"type": "string"}, "return_status": {"type": "string"}, "source": {"type": "string"}}}}, "notes": {"type": "string"}, "data_sources": {"type": "array", "items": {"type": "s